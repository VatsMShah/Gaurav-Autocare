{
  "version": "6.2",
  "screens": [
    {
      "id": "ADD_VEHICLE",
      "title": "Gaurav Auto Care \u2014 Add Vehicle",
      "terminal": true,
      "data": {
        "company_name": {
          "type": "string",
          "__example__": "Sheetal Parivahan"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "\u2795 Add New Vehicle"
          },
          {
            "type": "TextSubheading",
            "text": "Fleet Partner: Sheetal Parivahan"
          },
          {
            "type": "TextCaption",
            "text": "Register a new commercial truck to Sheetal Parivahan fleet."
          },
          {
            "type": "TextInput",
            "name": "vehicle_number",
            "label": "Full Vehicle Number",
            "required": true,
            "input-type": "text",
            "min-chars": 9,
            "max-chars": 12,
            "pattern": "^[A-Za-z]{2}\\s?[0-9]{2}\\s?[A-Za-z]{1,2}\\s?[0-9]{4}$",
            "helper-text": "e.g. MH04MH4857 (State + 2 RTO digits + Series + 4 digits)"
          },
          {
            "type": "Footer",
            "label": "\u2795 Add Vehicle",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "action": "add_vehicle",
                "vehicle_number": "${form.vehicle_number}"
              }
            }
          }
        ]
      }
    }
  ]
}