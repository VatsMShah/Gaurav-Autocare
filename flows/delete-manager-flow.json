          },
          {
            "type": "Dropdown",
            "name": "manager_phone",
            "label": "Select Manager Mobile Number",
            "required": true,
            "data-source": [
              {
                "id": "9323265076",
                "title": "+91 9323265076"
              },
              {
                "id": "9820500159",
                "title": "+91 9820500159"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "🗑️ Delete Manager",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "action": "delete_manager",
                "manager_phone": "${form.manager_phone}"
              }
            }
          }
        ]
      }
    }
  ]
}