{
  "version": "6.2",
  "screens": [
    {
      "id": "DELETE_MANAGER",
      "title": "Gaurav Auto Care — Delete Manager",
      "terminal": true,
      "data": {
        "company_name": {
          "type": "string",
          "__example__": "Sheetal Parivahan"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🗑️ Delete Manager"
          },
          {
            "type": "TextSubheading",
            "text": "Fleet Partner: Sheetal Parivahan"
          },
          {
